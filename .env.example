# AstroPulse AI Flight Surgeon Configuration

# Choose LLM Provider: 'groq', 'nebius', 'openai', or leave blank for internal expert
# Groq (Fastest Inference: Llama-3.3-70b-versatile, Llama-3.1-8b-instant)
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Nebius Studio (Alternative OpenAI-compatible High-Speed Inference)
# NEBIUS_API_KEY=
# LLM_PROVIDER=nebius
# LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
# LLM_BASE_URL=https://api.studio.nebius.ai/v1

# Bland AI (Conversational Voice AI & Outbound Phone Call Dispatch: https://bland.ai)
BLAND_API_KEY=
BLAND_VOICE=maya
BLAND_PHONE_NUMBER=+15550192834

# ──────────────────────────────────────────────────────────────────────────────
# BAND AI — Multi-Agent Communication & Coordination (https://band.ai)
# ──────────────────────────────────────────────────────────────────────────────
# Set BAND_ENABLED=true to activate the BAND integration.
# When false (default), the rest of AstroPulse continues working normally.
#
# How to obtain credentials:
#   1. Sign in at https://band.ai
#   2. Create a new Agent in the Agents dashboard
#   3. Copy the Agent ID (UUID) and API Key from the agent settings page
#   4. Paste them below — never share or commit these values
#
BAND_ENABLED=false
BAND_AGENT_ID=
BAND_AGENT_API_KEY=
